{
  "name": "mcp-stripe-revenue-server",
  "version": "0.1.0",
  "description": "MCP server exposing read-only Stripe revenue analytics (MRR, churn, failed payments, revenue summary)",
  "type": "module",
  "license": "MIT",
  "author": "Kien Phan",
  "bin": {
    "mcp-stripe-revenue-server": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "node dist/cli.js",
    "demo": "tsx src/cli.ts --demo",
    "check:deps-age": "node scripts/check-dep-age.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "stripe",
    "mrr",
    "churn",
    "analytics"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "stripe": "23.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
